# ---------------------------------------------------------------
# Planilha de leads (Google Apps Script)
# Passo a passo: apps-script/COMO-INSTALAR.md
# ---------------------------------------------------------------
# URL da publicação do Apps Script (termina em /exec)
SHEETS_URL=

# Frase secreta. Precisa ser IGUAL à constante SEGREDO no Code.gs.
# Sem NEXT_PUBLIC_: assim ela nunca chega ao navegador.
SHEETS_SEGREDO=

# ---------------------------------------------------------------
# Google Tag Manager
# ---------------------------------------------------------------
# ID do container, no formato GTM-XXXXXXX. Este precisa de
# NEXT_PUBLIC_ porque o script roda no navegador.
NEXT_PUBLIC_GTM_ID=
